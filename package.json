{
  "name": "nom-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "fake-wallet": "tsx scripts/fake-syrius.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "@walletconnect/modal": "^2.6.2",
    "@walletconnect/sign-client": "^2.11.0",
    "buffer": "^6.0.3",
    "lucide-vue-next": "^0.563.0",
    "nom-ui": "github:digitalSloth/nom-ui",
    "viem": "^2.55.2",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "znn-typescript-sdk": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.260",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@walletconnect/types": "^2.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "@open-rpc/client-js": {
      "ws": "8.21.0"
    }
  }
}
