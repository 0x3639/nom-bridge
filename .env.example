# Copy to `.env` (mainnet) and/or `.env.testnet` and fill in real values.
# These files are gitignored — never commit a real project id.

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Falls back to 'REPLACE_ME_WC_PROJECT_ID' in config.ts when unset, which lets
# the app build/run but makes WC pairing fail with a clear error.
VITE_WC_PROJECT_ID=REPLACE_ME_WC_PROJECT_ID
